{
  "name": "analyticaph/oauth-client",
  "description": "Shared OAuth 2.0 client flow, token exchange, and middleware for SmartCampus tenant apps.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "firebase/php-jwt": "^7.0",
    "illuminate/cache": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/routing": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "pestphp/pest": "^2.0|^3.0"
  },
  "autoload": {
    "psr-4": {
      "Analyticaph\\OAuthClient\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Analyticaph\\OAuthClient\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Analyticaph\\OAuthClient\\OAuthClientServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
